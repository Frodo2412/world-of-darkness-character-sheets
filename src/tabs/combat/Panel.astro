---
import { INCAPACITATED_REASON } from '../../domain/v20/combat/pools';
import { MANOEUVRES } from '../../domain/v20/combat/data/manoeuvres';
import { CALLED_SHOTS, RANGE_BANDS } from '../../domain/v20/combat/data/modifiers';
import { RANGED_WEAPONS } from '../../domain/v20/combat/data/ranged';
import { CONCEALMENT } from '../../domain/v20/combat/data/types';
import { MELEE_WEAPONS } from '../../domain/v20/combat/data/weapons';
import EmptyState from '../../components/dossier/EmptyState.astro';
import ReferenceTable from '../../components/dossier/ReferenceTable.astro';
import SearchField from '../../components/dossier/SearchField.astro';
import SegmentedControl from '../../components/dossier/SegmentedControl.astro';
import Reminders from './Reminders.astro';
import { calledShotLabel } from './text';
import { SECTION_FILTERS } from './section';
import './combat.css';

const MANOEUVRE_HEADINGS = ['Manoeuvre', 'Pool', 'Accuracy', 'Difficulty', 'Base damage', 'Page'];
const MELEE_WEAPON_HEADINGS = ['Weapon', 'Pool', 'Damage', 'Type', 'Conceal', 'Page', 'In roll'];
const RANGED_WEAPON_HEADINGS = ['Weapon', 'Pool', 'Damage', 'Range', 'Rate', 'Clip', 'Conceal', 'Page', 'In roll'];

/** What each concealment letter means, as the chart words it. */
/** The manoeuvres a picker offers, by section. */
const MELEE_MANOEUVRES = MANOEUVRES.filter((manoeuvre) => manoeuvre.section === 'melee');
const RANGED_MANOEUVRES = MANOEUVRES.filter((manoeuvre) => manoeuvre.section === 'ranged');

const CONCEALMENT_LEGEND = Object.entries(CONCEALMENT).map(([letter, meaning]) => `${letter}: ${meaning}`);
---

<div class="combat" data-combat>
	<!-- Where focus lands when the player opens this tab. -->
	<h2 class="combat-title" data-panel-heading>Combat</h2>
	<!-- Shown while the health track is fully marked Incapacitated. -->
	<p class="combat-incapacitated" data-field="incapacitated" hidden>{INCAPACITATED_REASON}</p>

	<!-- What the tables are, and what their pools leave out. -->
	<p class="combat-disclaimer">Rulebook reference — not owned equipment</p>
	<p class="combat-disclaimer">Base pools shown without Celerity, blood boosts, armor or situational modifiers</p>

	<div class="combat-controls">
		<SearchField id="combat-search" label="Search manoeuvres and weapons" />
		<!-- Nothing is pressed in the markup: the script presses the one in use when it draws. "All" presses neither sub-tab. -->
		<div data-control="section">
			<SegmentedControl label="Section shown" options={SECTION_FILTERS} pressed="" />
		</div>
		<div data-control="tables">
			<SegmentedControl
				label="Combat tables"
				options={[
					{ value: 'melee', label: 'Melee' },
					{ value: 'ranged', label: 'Ranged' },
				]}
				pressed=""
			/>
		</div>
	</div>

	<div data-state="no-match" hidden>
		<EmptyState message="No manoeuvres or weapons match." />
	</div>

	<div class="combat-layout">
	<div class="combat-tables">
	<section class="combat-group" aria-label="Close combat" data-group="melee">
		<div data-table="melee-manoeuvres">
			<ReferenceTable caption="Close combat manoeuvres" headings={MANOEUVRE_HEADINGS} />
		</div>
		<div data-table="melee-weapons">
			<ReferenceTable caption="Melee weapons" headings={MELEE_WEAPON_HEADINGS} />
			<p class="combat-legend">Conceal: {CONCEALMENT_LEGEND.join(' · ')}</p>
		</div>
	</section>

	<section class="combat-group" aria-label="Ranged combat" data-group="ranged">
		<div data-table="ranged-manoeuvres">
			<ReferenceTable caption="Ranged manoeuvres" headings={MANOEUVRE_HEADINGS} />
		</div>
		<div data-table="ranged-weapons">
			<ReferenceTable caption="Ranged weapons" headings={RANGED_WEAPON_HEADINGS} />
			<p class="combat-legend">Conceal: {CONCEALMENT_LEGEND.join(' · ')}</p>
		</div>
	</section>

	</div>

	<section class="combat-roll" aria-labelledby="combat-roll-heading" data-roll>
		<h3 class="combat-roll-heading" id="combat-roll-heading">Weapon roll</h3>
		<p class="combat-roll-note">Pools only — roll your own dice.</p>

		<div class="combat-roll-fields">
			<label class="combat-field">
				<span class="combat-field-label">Weapon</span>
				<select data-input="weapon">
					<option value="">No weapon</option>
					<optgroup label="Melee weapons">
						{MELEE_WEAPONS.map((weapon) => <option value={weapon.name}>{weapon.name}</option>)}
					</optgroup>
					<optgroup label="Ranged weapons">
						{RANGED_WEAPONS.map((weapon) => <option value={weapon.name}>{weapon.name}</option>)}
					</optgroup>
				</select>
			</label>
			<label class="combat-field">
				<span class="combat-field-label">Manoeuvre</span>
				<select data-input="manoeuvre">
					<option value="">Choose a manoeuvre</option>
					<optgroup label="Close combat">
						{MELEE_MANOEUVRES.map((manoeuvre) => <option value={manoeuvre.name}>{manoeuvre.name}</option>)}
					</optgroup>
					<optgroup label="Ranged combat">
						{RANGED_MANOEUVRES.map((manoeuvre) => <option value={manoeuvre.name}>{manoeuvre.name}</option>)}
					</optgroup>
				</select>
			</label>
			<label class="combat-field">
				<span class="combat-field-label">Target</span>
				<select data-input="target">
					<option value="">Any size</option>
					{CALLED_SHOTS.map((shot) => <option value={shot.key}>{calledShotLabel(shot)}</option>)}
				</select>
			</label>
			<label class="combat-field">
				<span class="combat-field-label">Range</span>
				<select data-input="range">
					<option value="">Standard difficulty</option>
					{RANGE_BANDS.map((band) => <option value={band.key}>{band.label}</option>)}
				</select>
			</label>
			<label class="combat-field">
				<span class="combat-field-label">Dice modifier</span>
				<input type="number" step="1" inputmode="numeric" data-input="dice" />
			</label>
			<label class="combat-field">
				<span class="combat-field-label">Difficulty modifier</span>
				<input type="number" step="1" inputmode="numeric" data-input="difficulty" />
			</label>
			<label class="combat-field">
				<span class="combat-field-label">Extra successes</span>
				<input type="number" step="1" min="0" inputmode="numeric" data-input="extra" />
			</label>
		</div>
		<!-- Said when an entry of extra successes below 0 is kept at 0. -->
		<p class="combat-hint combat-hint-correction" role="status" data-field="extra-hint" hidden></p>
		<p class="combat-hint" data-field="target-note" hidden></p>
		<p class="combat-hint" data-field="range-note" hidden></p>

		<!-- What "Use in roll" brings into view and focuses on a narrow screen. -->
		<div class="combat-result" role="group" aria-labelledby="combat-result-heading" tabindex="-1" data-result>
			<h4 class="combat-result-heading" id="combat-result-heading">Result</h4>

			<div class="combat-pool">
				<p class="combat-pool-label">Attack pool</p>
				<p class="combat-hint" data-field="choose-manoeuvre">Choose a manoeuvre to see the attack pool.</p>
				<div data-field="attack" hidden>
					<p class="combat-pool-total" data-field="attack-pool"></p>
					<p class="combat-formula" data-field="attack-formula"></p>
					<dl class="combat-readout">
						<div class="combat-readout-row"><dt>Accuracy</dt><dd data-field="accuracy"></dd></div>
						<div class="combat-readout-row"><dt>Difficulty</dt><dd data-field="difficulty"></dd></div>
					</dl>
				</div>
			</div>

			<div class="combat-pool">
				<p class="combat-pool-label">Damage pool</p>
				<p class="combat-hint" data-field="choose-weapon">Choose a weapon to see the damage pool.</p>
				<div data-field="damage" hidden>
					<p class="combat-pool-total" data-field="damage-pool"></p>
					<p class="combat-formula" data-field="damage-formula"></p>
					<dl class="combat-readout">
						<div class="combat-readout-row"><dt>Type</dt><dd data-field="damage-type"></dd></div>
						<div class="combat-readout-row"><dt>Difficulty</dt><dd data-field="damage-difficulty"></dd></div>
					</dl>
				</div>
			</div>
		</div>
	</section>
	</div>

	<Reminders />

	<!-- Drawn from, never shown: the script copies each into the tables above. -->
	<template data-template="manoeuvre">
		<tr>
			<th scope="row" class="combat-name">
				<span data-field="name"></span>
				<!-- What the manoeuvre needs and the character lacks, in words. -->
				<span class="combat-mark" data-field="unavailable" hidden></span>
				<span class="combat-mark" data-field="tags" hidden></span>
				<span class="combat-note" data-field="requirement" hidden></span>
				<span class="combat-note" data-field="uses" hidden></span>
			</th>
			<td>
				<span class="combat-dice" data-field="pool"></span>
				<span class="combat-formula" data-field="formula"></span>
			</td>
			<td data-field="accuracy"></td>
			<td data-field="difficulty"></td>
			<td>
				<span data-field="damage"></span>
				<span class="combat-effects" data-field="effects"></span>
			</td>
			<td class="combat-page" data-field="page"></td>
		</tr>
	</template>
	<template data-template="melee-weapon">
		<tr>
			<th scope="row" class="combat-name">
				<span data-field="name"></span>
				<span class="combat-note" data-field="note"></span>
			</th>
			<td>
				<span class="combat-dice" data-field="pool"></span>
				<span class="combat-formula" data-field="formula"></span>
			</td>
			<td data-field="damage"></td>
			<td data-field="type"></td>
			<td data-field="conceal"></td>
			<td class="combat-page" data-field="page"></td>
			<td>
				<button type="button" class="combat-use" aria-pressed="false" data-field="use">
					<span class="combat-use-mark" aria-hidden="true">✓</span>
					Use in roll
				</button>
			</td>
		</tr>
	</template>
	<template data-template="ranged-weapon">
		<tr>
			<th scope="row" class="combat-name">
				<span data-field="name"></span>
				<span class="combat-note" data-field="automatic"></span>
				<span class="combat-note" data-field="example"></span>
				<span class="combat-note" data-field="note"></span>
			</th>
			<td>
				<span class="combat-dice" data-field="pool"></span>
				<span class="combat-formula" data-field="formula"></span>
			</td>
			<td data-field="damage"></td>
			<td data-field="range"></td>
			<td data-field="rate"></td>
			<td data-field="clip"></td>
			<td data-field="conceal"></td>
			<td class="combat-page" data-field="page"></td>
			<td>
				<button type="button" class="combat-use" aria-pressed="false" data-field="use">
					<span class="combat-use-mark" aria-hidden="true">✓</span>
					Use in roll
				</button>
			</td>
		</tr>
	</template>
</div>
