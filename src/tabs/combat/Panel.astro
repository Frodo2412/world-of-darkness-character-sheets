---
import { CONCEALMENT } from '../../domain/v20/combat/data/types';
import EmptyState from '../../components/dossier/EmptyState.astro';
import ReferenceTable from '../../components/dossier/ReferenceTable.astro';
import SearchField from '../../components/dossier/SearchField.astro';
import SegmentedControl from '../../components/dossier/SegmentedControl.astro';
import { SECTION_FILTERS } from './section';
import './combat.css';

const MANOEUVRE_HEADINGS = ['Manoeuvre', 'Pool', 'Accuracy', 'Difficulty', 'Base damage', 'Page'];
const MELEE_WEAPON_HEADINGS = ['Weapon', 'Pool', 'Damage', 'Type', 'Conceal', 'Page', 'In roll'];
const RANGED_WEAPON_HEADINGS = ['Weapon', 'Pool', 'Damage', 'Range', 'Rate', 'Clip', 'Conceal', 'Page', 'In roll'];

/** What each concealment letter means, as the chart words it. */
const CONCEALMENT_LEGEND = Object.entries(CONCEALMENT).map(([letter, meaning]) => `${letter}: ${meaning}`);
---

<div class="combat" data-combat>
	<!-- Where focus lands when the player opens this tab. -->
	<h2 class="combat-title" data-panel-heading>Combat</h2>

	<div class="combat-controls">
		<SearchField id="combat-search" label="Search manoeuvres and weapons" />
		<!-- Nothing is pressed in the markup: the script presses the one in use when it draws. "All" presses neither sub-tab. -->
		<div data-control="section">
			<SegmentedControl label="Section shown" options={SECTION_FILTERS} pressed="" />
		</div>
		<div data-control="tables">
			<SegmentedControl
				label="Combat tables"
				options={[
					{ value: 'melee', label: 'Melee' },
					{ value: 'ranged', label: 'Ranged' },
				]}
				pressed=""
			/>
		</div>
	</div>

	<div data-state="no-match" hidden>
		<EmptyState message="No manoeuvres or weapons match." />
	</div>

	<section class="combat-group" aria-label="Close combat" data-group="melee">
		<div data-table="melee-manoeuvres">
			<ReferenceTable caption="Close combat manoeuvres" headings={MANOEUVRE_HEADINGS} />
		</div>
		<div data-table="melee-weapons">
			<ReferenceTable caption="Melee weapons" headings={MELEE_WEAPON_HEADINGS} />
			<p class="combat-legend">Conceal: {CONCEALMENT_LEGEND.join(' · ')}</p>
		</div>
	</section>

	<section class="combat-group" aria-label="Ranged combat" data-group="ranged">
		<div data-table="ranged-manoeuvres">
			<ReferenceTable caption="Ranged manoeuvres" headings={MANOEUVRE_HEADINGS} />
		</div>
		<div data-table="ranged-weapons">
			<ReferenceTable caption="Ranged weapons" headings={RANGED_WEAPON_HEADINGS} />
			<p class="combat-legend">Conceal: {CONCEALMENT_LEGEND.join(' · ')}</p>
		</div>
	</section>

	<!-- Drawn from, never shown: the script copies each into the tables above. -->
	<template data-template="manoeuvre">
		<tr>
			<th scope="row" class="combat-name"><span data-field="name"></span></th>
			<td>
				<span class="combat-dice" data-field="pool"></span>
				<span class="combat-formula" data-field="formula"></span>
			</td>
			<td data-field="accuracy"></td>
			<td data-field="difficulty"></td>
			<td>
				<span data-field="damage"></span>
				<span class="combat-effects" data-field="effects"></span>
			</td>
			<td class="combat-page" data-field="page"></td>
		</tr>
	</template>
	<template data-template="melee-weapon">
		<tr>
			<th scope="row" class="combat-name">
				<span data-field="name"></span>
				<span class="combat-note" data-field="note"></span>
			</th>
			<td>
				<span class="combat-dice" data-field="pool"></span>
				<span class="combat-formula" data-field="formula"></span>
			</td>
			<td data-field="damage"></td>
			<td data-field="type"></td>
			<td data-field="conceal"></td>
			<td class="combat-page" data-field="page"></td>
			<td>
				<button type="button" class="combat-use" aria-pressed="false" data-field="use">
					<span class="combat-use-mark" aria-hidden="true">✓</span>
					Use in roll
				</button>
			</td>
		</tr>
	</template>
	<template data-template="ranged-weapon">
		<tr>
			<th scope="row" class="combat-name">
				<span data-field="name"></span>
				<span class="combat-note" data-field="automatic"></span>
				<span class="combat-note" data-field="example"></span>
				<span class="combat-note" data-field="note"></span>
			</th>
			<td>
				<span class="combat-dice" data-field="pool"></span>
				<span class="combat-formula" data-field="formula"></span>
			</td>
			<td data-field="damage"></td>
			<td data-field="range"></td>
			<td data-field="rate"></td>
			<td data-field="clip"></td>
			<td data-field="conceal"></td>
			<td class="combat-page" data-field="page"></td>
			<td>
				<button type="button" class="combat-use" aria-pressed="false" data-field="use">
					<span class="combat-use-mark" aria-hidden="true">✓</span>
					Use in roll
				</button>
			</td>
		</tr>
	</template>
</div>
