---
import SearchField from '../../components/dossier/SearchField.astro';
import SegmentedControl from '../../components/dossier/SegmentedControl.astro';
import '../../styles/dossier.css';
import './disciplines.css';

// Static markup only; `mount.ts` fills the list and the detail from the character.
const views = [
	{ value: 'owned', label: 'Owned' },
	{ value: 'all', label: 'All disciplines' },
];
---

<div class="dossier-panel disciplines">
	<h2 class="dossier-title" data-panel-heading>Disciplines</h2>
	<p class="dossier-lead">Edit Discipline ratings on the <a href="/" data-open-sheet>Character sheet</a>.</p>
	<div class="dossier-toolbar">
		<SearchField id="disciplines-search" label="Search disciplines and powers" placeholder="Name or summary" />
		<SegmentedControl label="Disciplines shown" options={views} pressed="owned" />
	</div>
	<div class="dossier-empty disciplines-none" data-none hidden>
		<p class="dossier-empty-message">This character has no Disciplines recorded.</p>
		<div class="dossier-empty-action">
			<button type="button" data-show-all>Browse all disciplines</button>
		</div>
	</div>
	<p class="dossier-empty dossier-empty-message disciplines-no-match" data-no-match hidden>No Disciplines or powers match the search.</p>
	<div class="dossier-split" data-split>
		<ul class="dossier-list disciplines-list" aria-label="Disciplines" data-discipline-list></ul>
		<section class="card disciplines-detail" aria-labelledby="discipline-detail-title" data-discipline-detail>
			<div class="disciplines-detail-head">
				<h3 class="dossier-card-title" id="discipline-detail-title" data-detail-name></h3>
				<p class="disciplines-rating">
					<span class="disciplines-rating-label">Your rating</span>
					<span class="disciplines-rating-dots" data-detail-dots></span>
					<span class="disciplines-rating-value" data-detail-rating></span>
				</p>
			</div>
			<p class="dossier-lead" data-detail-note hidden></p>
			<ul class="disciplines-powers" aria-label="Powers" data-power-list></ul>
		</section>
	</div>
</div>
