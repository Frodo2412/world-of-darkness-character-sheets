---
import StatusMessage from '../components/StatusMessage.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Characters">
	<main>
		<h1 id="roster-heading">Characters</h1>
		<StatusMessage />
		<button type="button" id="new-character">New V20 character</button>
		<p id="roster-empty" hidden>No characters yet. Create one to get started.</p>
		<ul id="roster" aria-labelledby="roster-heading" hidden></ul>
		<dialog id="delete-dialog" aria-labelledby="delete-dialog-title" aria-describedby="delete-dialog-message">
			<h2 id="delete-dialog-title">Delete character?</h2>
			<p id="delete-dialog-message"></p>
			<form method="dialog">
				<button value="cancel" autofocus>Cancel</button>
				<button value="confirm">Delete</button>
			</form>
		</dialog>
	</main>
</Layout>

<script>
	import '../scripts/roster';
</script>
