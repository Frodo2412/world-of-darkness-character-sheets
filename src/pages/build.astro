---
import Abilities from '../components/builder/Abilities.astro';
import Advantages from '../components/builder/Advantages.astro';
import Attributes from '../components/builder/Attributes.astro';
import Concept from '../components/builder/Concept.astro';
import FinishingTouches from '../components/builder/FinishingTouches.astro';
import ScreenNav from '../components/builder/ScreenNav.astro';
import ScreenPanel from '../components/builder/ScreenPanel.astro';
import SettingsDialog from '../components/builder/SettingsDialog.astro';
import Sidebar from '../components/builder/Sidebar.astro';
import StatusMessage from '../components/StatusMessage.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/builder.css';
---

<Layout title="Build a character">
	<main>
		<p><a href="/">Back to characters</a></p>
		<StatusMessage />
		<div id="builder" class="builder" hidden>
			<div class="builder-header">
				<h1>Build a character</h1>
				<button type="button" data-settings-open>Creation settings</button>
			</div>
			<div class="builder-shell">
				<Sidebar />
				<div class="builder-main">
					<!-- The freebie points remaining, kept in view on every screen until the "Your character" panel takes them. -->
					<p class="builder-freebies" role="status" aria-atomic="true" data-freebie-remaining data-freebie-bar></p>
					<ScreenPanel screen="concept"><Concept /></ScreenPanel>
					<ScreenPanel screen="clan" />
					<ScreenPanel screen="natureDemeanor" />
					<ScreenPanel screen="attributes"><Attributes /></ScreenPanel>
					<ScreenPanel screen="abilities"><Abilities /></ScreenPanel>
					<ScreenPanel screen="advantages"><Advantages /></ScreenPanel>
					<ScreenPanel screen="finishing"><FinishingTouches /></ScreenPanel>
					<ScreenPanel screen="review" />
					<ScreenPanel screen="summary" />
					<ScreenNav />
				</div>
			</div>
			<SettingsDialog />
			<dialog id="finish-dialog" aria-labelledby="finish-dialog-title" aria-describedby="finish-dialog-message" data-finish-dialog>
				<h2 id="finish-dialog-title">Finish with unspent freebie points?</h2>
				<p id="finish-dialog-message" data-finish-dialog-message></p>
				<form method="dialog">
					<button value="keep" autofocus>Keep editing</button>
					<button value="finish" data-finish-confirm></button>
				</form>
			</dialog>
		</div>
		<div id="build-unreadable" hidden>
			<h1>Build could not be read</h1>
			<p>The saved data for this build is damaged or was saved by a different version. It has not been changed.</p>
			<p>You can build a new character from your characters.</p>
			<p><a href="/">Go to your characters</a></p>
		</div>
		<div id="build-not-found" hidden>
			<h1>Build not found</h1>
			<p>Build not found. It may have been finished or deleted.</p>
			<p><a href="/">Go to your characters</a></p>
		</div>
	</main>
</Layout>

<script>
	import '../scripts/builder';
</script>
