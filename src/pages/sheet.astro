---
import Abilities from '../components/sheet/Abilities.astro';
import Advantages from '../components/sheet/Advantages.astro';
import Attributes from '../components/sheet/Attributes.astro';
import Health from '../components/sheet/Health.astro';
import Morality from '../components/sheet/Morality.astro';
import Notes from '../components/sheet/Notes.astro';
import SheetHeader from '../components/sheet/SheetHeader.astro';
import Trackers from '../components/sheet/Trackers.astro';
import WeaknessExperience from '../components/sheet/WeaknessExperience.astro';
import { CREATION_REMINDER } from '../domain/v20/traits';
import StatusMessage from '../components/StatusMessage.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/sheet.css';
---

<Layout title="Character sheet">
	<main>
		<StatusMessage />
		<div id="sheet" class="sheet" hidden>
			<h1>Character sheet</h1>
			<SheetHeader />
			<Attributes />
			<Abilities />
			<Advantages />
			<div class="columns">
				<div class="sheet-column"><Notes /></div>
				<div class="sheet-column">
					<Morality />
					<Trackers />
				</div>
				<div class="sheet-column">
					<Health />
					<WeaknessExperience />
				</div>
			</div>
			<p class="creation-reminder">{CREATION_REMINDER}</p>
		</div>
		<div id="sheet-unreadable" hidden>
			<h1>Character could not be read</h1>
			<p>The saved data for this character is damaged or was saved by a different version. It has been left untouched.</p>
			<p><a href="/">Go to your characters</a></p>
		</div>
		<div id="sheet-not-found" hidden>
			<h1>Character not found</h1>
			<p>No saved character matches this address. It may have been deleted, or saved in a different browser.</p>
			<p><a href="/">Go to your characters</a></p>
		</div>
	</main>
</Layout>

<script>
	import '../scripts/sheet';
</script>
