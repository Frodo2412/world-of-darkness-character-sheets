---
// One flat allotment's rows where freebie points buy them (Finishing touches): a heading, the rows in the
// slot and a message slot. The Advantages screen draws its own cards.
interface Props {
	key: string;
	label: string;
	step: string;
}

const { key, label, step } = Astro.props;
const id = `${step}-${key}`;
---

<div class="trait-group builder-group" role="group" aria-labelledby={`${id}-label`}>
	<h3>
		<span id={`${id}-label`}>{label}</span>
	</h3>
	<slot />
	<p id={`${id}-notice`} class="field-notice" role="status" data-notice></p>
</div>
