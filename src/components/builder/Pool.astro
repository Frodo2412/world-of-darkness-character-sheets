---
// A pool card's meter and counts, and its callout when `callout` is set. The screen module
// (scripts/builder/parts/pool.ts) writes everything that changes, from a pool view: the ranked groups of
// Attributes and Abilities and the cards of Advantages draw the same parts.
interface Props {
	callout?: boolean;
}

const { callout = false } = Astro.props;
---

<div class="ranked-pool" data-pool>
	<div class="builder-meter ranked-meter" aria-hidden="true" data-pool-meter />
	<p class="ranked-pool-line">
		<span class="ranked-remaining" data-pool-remaining />
		<span class="builder-status" data-pool-spent />
	</p>
	<span class="visually-hidden" role="status" data-pool-status />
</div>
{
	callout && (
		<div class="builder-callout ranked-callout" data-callout hidden>
			<h4 class="ranked-callout-heading" data-callout-heading />
			<p data-callout-summary />
			<p data-callout-traits />
		</div>
	)
}
