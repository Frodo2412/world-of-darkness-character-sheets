---
// A ranked creation screen (Attributes, Abilities): the intro card, a card for each group and the "What the
// choices say" card. The screen module (scripts/builder/parts/ranked.ts) writes the intro, the priority line
// and the summary, and everything inside the groups, from `rankedView`.
import type { RankedAllotment } from '../../domain/v20/creation/rules';
import RankedGroup from './RankedGroup.astro';

interface Props {
	allotment: RankedAllotment;
}

const { allotment } = Astro.props;
const { primary, secondary, tertiary } = allotment.rankDots;
---

<div class="ranked-screen" data-ranked-screen={allotment.key}>
	<div class="builder-card ranked-intro">
		<p class="ranked-text">Rank the groups primary, secondary and tertiary for {primary}, {secondary} and {tertiary} dots.</p>
		<p class="builder-helper ranked-text" data-ranked-intro></p>
		<p class="builder-status ranked-text" data-ranked-priority hidden></p>
	</div>
	<div class="builder-columns">
		{allotment.groups.map((group) => <RankedGroup allotment={allotment} group={group} mode="creation" step={allotment.step} />)}
	</div>
	<div class="builder-card ranked-summary">
		<h3 class="ranked-heading">What the choices say</h3>
		<ul class="ranked-lines" data-ranked-summary></ul>
	</div>
</div>
