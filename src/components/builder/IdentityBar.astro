---
// Who is being built: an initials avatar, the name, what is known about the character, the Nature and
// Demeanor so far, and Save & exit. The shell fills the text from the build.
---

<div class="builder-identity">
	<span class="builder-avatar" aria-hidden="true" data-identity-initials></span>
	<div class="builder-identity-text">
		<p class="builder-identity-name" data-identity-name></p>
		<p class="builder-identity-subtitle" data-identity-subtitle></p>
	</div>
	<p class="builder-identity-natdem">
		<span class="builder-status">Nature / Demeanor</span>
		<span data-identity-natdem></span>
	</p>
	<button type="button" data-save-exit>Save &amp; exit</button>
</div>
