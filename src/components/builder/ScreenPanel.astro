---
// One builder screen: a heading-led region. The router shows one panel at a time and moves focus to
// its heading; a screen that is not built yet is this heading alone. The eyebrow above the heading is
// the phase in words, set in capitals by the stylesheet; it is a paragraph, not a heading.
import type { ScreenId } from '../../domain/v20/creation/rules';
import { phaseEyebrow } from '../../domain/v20/creation/screens';
import { screenTitle } from '../../domain/v20/creation/wording';

interface Props {
	screen: ScreenId;
}

const { screen } = Astro.props;
const title = screenTitle(screen);
---

<section class="builder-step" data-step={screen} aria-labelledby={`step-${screen}-heading`} hidden>
	<p class="builder-eyebrow">{phaseEyebrow(screen)}</p>
	<h2 id={`step-${screen}-heading`} tabindex="-1">{title}</h2>
	<slot />
</section>
