---
import Abilities from '../sheet/Abilities.astro';
import Attributes from '../sheet/Attributes.astro';
import Disciplines from '../sheet/Disciplines.astro';
import SelectedPool from '../sheet/SelectedPool.astro';
import Virtues from '../sheet/Virtues.astro';
---

<!-- The Character sheet's panel: the tab that is always there, so it has no folder under src/tabs. -->
<div class="workspace">
	<!-- First in the markup so that a narrow screen shows it above the traits; the stylesheet puts it at the top of the side column when wide. -->
	<SelectedPool />
	<div class="workspace-traits">
		<Attributes />
		<Abilities />
	</div>
	<div class="workspace-side">
		<Disciplines />
		<Virtues />
	</div>
</div>
