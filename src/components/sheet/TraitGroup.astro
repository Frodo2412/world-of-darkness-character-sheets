---
import type { TraitRef } from '../../domain/v20/traits';
import SheetTraitRow from './SheetTraitRow.astro';

interface Props {
	label: string;
	section: 'attributes' | 'abilities';
	traits: readonly { key: string; label: string }[];
}

const { label, section, traits } = Astro.props;
const headingId = `${section}-${label.toLowerCase()}-heading`;
---

<div class="card trait-group trait-card" role="group" aria-labelledby={headingId}>
	<h3 id={headingId}>{label}</h3>
	<div class="trait-rows">
		{traits.map((trait) => <SheetTraitRow trait={`${section}.${trait.key}` as TraitRef} label={trait.label} />)}
		<slot />
	</div>
</div>
