---
import { ABILITY_GROUPS } from '../../domain/v20/traits';
import NamedRatingRow from './NamedRatingRow.astro';
import SheetTraitRow from './SheetTraitRow.astro';
import TraitGroup from './TraitGroup.astro';
---

<section class="trait-section" aria-labelledby="abilities-heading">
	<div class="trait-section-head">
		<h2 id="abilities-heading">Abilities</h2>
		<p class="trait-hint" data-sheet-mode-only="play">Read-only in play · edit character to change</p>
	</div>
	<div class="trait-cards">
	{
		ABILITY_GROUPS.map((group) => (
			<TraitGroup label={group.label} section="abilities" traits={group.traits}>
				<SheetTraitRow customGroup={group.key} label={group.customLabel} />
				<NamedRatingRow row={`customAbilities.${group.key}`} label={group.customLabel} />
			</TraitGroup>
		))
	}
	</div>
</section>
