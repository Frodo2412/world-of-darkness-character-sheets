---
import { VIRTUES } from '../../domain/v20/traits';
import RatingRow from './RatingRow.astro';
---

<section aria-labelledby="advantages-heading">
	<h2 id="advantages-heading">Advantages</h2>
	<div class="columns">
	<div class="trait-group" role="group" aria-labelledby="virtues-heading">
		<h3 id="virtues-heading">Virtues</h3>
		{VIRTUES.map((virtue) => <RatingRow trait={`virtues.${virtue.key}`} label={virtue.label} />)}
	</div>
	</div>
</section>
