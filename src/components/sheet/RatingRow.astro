---
import { rangeOf, type TraitRef } from '../../domain/v20/traits';

interface Props {
	trait: TraitRef;
	label: string;
}

const { trait, label } = Astro.props;
---

<div class="rating-row">
	<span>{label}</span>
	<dot-rating data-trait={trait} data-label={label} aria-label={label} max={rangeOf(trait).max} value="0"
	></dot-rating>
</div>
