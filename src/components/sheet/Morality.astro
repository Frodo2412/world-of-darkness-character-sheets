---
import RatingRow from './RatingRow.astro';
---

<section aria-labelledby="humanity-heading">
	<h2 id="humanity-heading">Humanity / Path</h2>
	<label>
		Path name
		<input type="text" data-text="humanity.pathName" autocomplete="off" />
	</label>
	<RatingRow trait="humanity.rating" label="Humanity / Path" />
	<label>
		Bearing
		<input type="text" data-text="humanity.bearing" autocomplete="off" />
	</label>
	<label>
		Bearing modifier
		<input type="text" data-text="humanity.bearingModifier" autocomplete="off" />
	</label>
</section>
