---
import { ATTRIBUTE_GROUPS } from '../../domain/v20/traits';
import TraitGroup from './TraitGroup.astro';
---

<section class="trait-section" aria-labelledby="attributes-heading">
	<div class="trait-section-head">
		<h2 id="attributes-heading">Attributes</h2>
		<p class="trait-hint" data-sheet-mode-only="play">Select one attribute and one ability for a dice pool</p>
	</div>
	<div class="trait-cards">
		{ATTRIBUTE_GROUPS.map((group) => <TraitGroup label={group.label} section="attributes" traits={group.traits} />)}
	</div>
</section>
