---
import chevronDown from '../../assets/icons/chevron-down.svg';
import search from '../../assets/icons/search.svg';

// The browsing tools above the list card, in two rows. The first holds the search field and the clan filter;
// the second the list controls: the status filter now, and the sort control of a later slice.
// The search field is a native search box, named by a label the eye does not need: the placeholder says what
// to type, the label says what the field is for. It is outside any form, so pressing Enter submits nothing.
// The clan filter is a native select, its options written once by the script from the clans in the library.
// The status filter is a fieldset of two native radios drawn as segments: one tab stop, the arrow keys move
// between them, and one is always chosen. A label reads like a tab does, "Ready to play · 3": the dot is
// for the eye, and a comma that is not drawn takes its place for assistive technology.
// Every control's value is written by the script from the filter it holds, so none says what it holds here.
// Hidden until there is a library to browse.
// The shortcut hint is empty and hidden until the script writes it: which keys it names depends on the platform.
---

<div id="library-tools" class="library-tools" hidden>
	<div class="tools-row">
		<div class="search-field">
			<img src={search.src} alt="" width="16" height="16" />
			<label for="library-search" class="visually-hidden">Search characters</label>
			<input
				id="library-search"
				class="search-input"
				type="search"
				autocomplete="off"
				placeholder="Search by name, clan, or concept…"
			/>
			<span class="search-hint" data-slot="search-hint" aria-hidden="true" hidden></span>
		</div>
		<div class="clan-field">
			<label for="library-clan" class="visually-hidden">Clan</label>
			<select id="library-clan" class="clan-select" autocomplete="off"></select>
			<img src={chevronDown.src} alt="" width="12" height="12" />
		</div>
	</div>
	<div class="list-controls">
		<fieldset id="library-status" class="status-filter">
			<legend class="visually-hidden">Status</legend>
			<label class="status-segment">
				<input type="radio" name="library-status" value="all" autocomplete="off" />
				<span class="status-text">
					<span data-slot="status-label">All</span><span aria-hidden="true"> · </span><span class="tab-comma">, </span><span data-slot="status-count"></span>
				</span>
			</label>
			<label class="status-segment">
				<input type="radio" name="library-status" value="ready" autocomplete="off" />
				<span class="status-text">
					<span data-slot="status-label">Ready to play</span><span aria-hidden="true"> · </span><span class="tab-comma">, </span><span data-slot="status-count"></span>
				</span>
			</label>
		</fieldset>
	</div>
</div>
